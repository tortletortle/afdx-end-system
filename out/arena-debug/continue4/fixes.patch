### sim/tb/tb_t14_stats_regs.v  [new file (continue4)]
--- a/sim/tb/tb_t14_stats_regs.v
+++ b/sim/tb/tb_t14_stats_regs.v
@@ -0,0 +1,335 @@
+// =====================================================================
+// T14 —— 全局统计页 stats_regs（0x0100~0x01FF）
+// A 部分（单元级）：直接驱动 stats_regs 事件口，校验帧/字节/丢弃计数、
+//   帧长 8 桶与前 8 VL 直方图、复位清零、W1C 与读清语义、冻结、
+//   "同拍清零 + 事件"不丢事件、0x00~0x03 镜像只读。
+// B 部分（顶层）：AFDX_top 前门读写 0x0100~0x01FF，真实 64 B 金标帧经
+//   mac_rx_if→lookup→FLT→IC→RM 流过，TB 侧独立累加与寄存器回读比对；
+//   并校验统计页写不再误置 ERR.ACC、只读镜像写仍置 ERR.ACC。
+// 边界：dmac/ip_csum/udp_csum 三类无判决源，B 部分不对其断言非零。
+// =====================================================================
+`timescale 1 ns / 1 ps
+module tb_t14_stats_regs;
+  integer errors = 0;
+  reg clk = 0;
+  always #4 clk = ~clk;
+  task bad;
+    input [8*110-1:0] reason;
+    begin if (errors < 24) $display("  [err] T14: %0s", reason); errors = errors + 1; end
+  endtask
+
+  // ---------------- A 部分：单元级 ----------------
+  reg        u_rst = 1'b1, u_freeze = 1'b0;
+  reg        u_rx_in_evt = 0;  reg [10:0] u_rx_in_len = 0;
+  reg        u_rx_acc_evt = 0; reg [10:0] u_rx_acc_len = 0;
+  reg [11:0] u_rx_acc_vl = 0;  reg [23:0] u_rx_acc_ts = 0;
+  reg        u_tx_evt = 0;     reg [12:0] u_tx_len = 0;
+  reg [11:0] u_drop_evt = 0;
+  reg [31:0] u_pb0 = 32'h1111_0000, u_pb1 = 32'h2222_0000,
+             u_pb2 = 32'h3333_0000, u_pb3 = 32'h4444_0000;
+  reg        u_rd = 0, u_wr = 0;
+  reg [7:0]  u_off = 0;
+  reg [31:0] u_wdata = 0;
+  wire [31:0] u_rdata;
+  wire        u_wrok;
+  stats_regs uut (
+    .clk(clk), .rst_sync(u_rst), .freeze(u_freeze),
+    .rx_in_evt(u_rx_in_evt), .rx_in_len(u_rx_in_len),
+    .rx_acc_evt(u_rx_acc_evt), .rx_acc_len(u_rx_acc_len),
+    .rx_acc_vl(u_rx_acc_vl), .rx_acc_ts(u_rx_acc_ts),
+    .tx_evt(u_tx_evt), .tx_len(u_tx_len), .drop_evt(u_drop_evt),
+    .pb_deliver_cnt(u_pb0), .pb_port_drop_cnt(u_pb1),
+    .pb_ovr_cnt(u_pb2), .pb_qovf_cnt(u_pb3),
+    .host_rd(u_rd), .host_wr(u_wr), .host_off(u_off), .host_wdata(u_wdata),
+    .host_rdata(u_rdata), .wr_ok(u_wrok),
+    .snmp_off(8'h00), .snmp_rdata(), .jit_max_o(), .drop_total_o());
+
+  task peek;                       // 纯组合观测，不产生读清
+    input [7:0] off; output [31:0] d;
+    begin u_off = off; #1; d = u_rdata; end
+  endtask
+  task uread;                      // 带 strobe 的读（RD_CLR_EN=1 时读清）
+    input [7:0] off; output [31:0] d;
+    begin @(negedge clk); u_off = off; u_rd = 1'b1; #1; d = u_rdata;
+          @(negedge clk); u_rd = 1'b0; end
+  endtask
+  task uwrite;
+    input [7:0] off; input [31:0] data;
+    begin @(negedge clk); u_off = off; u_wdata = data; u_wr = 1'b1;
+          @(negedge clk); u_wr = 1'b0; end
+  endtask
+  task rx_in;
+    input [10:0] len;
+    begin @(negedge clk); u_rx_in_evt = 1; u_rx_in_len = len;
+          @(negedge clk); u_rx_in_evt = 0; end
+  endtask
+  task rx_acc;
+    input [10:0] len; input [11:0] vl; input [23:0] ts;
+    begin @(negedge clk); u_rx_acc_evt = 1; u_rx_acc_len = len;
+          u_rx_acc_vl = vl; u_rx_acc_ts = ts;
+          @(negedge clk); u_rx_acc_evt = 0; end
+  endtask
+  task tx_ev;
+    input [12:0] len;
+    begin @(negedge clk); u_tx_evt = 1; u_tx_len = len;
+          @(negedge clk); u_tx_evt = 0; end
+  endtask
+  task drop_ev;
+    input [11:0] m;
+    begin @(negedge clk); u_drop_evt = m; @(negedge clk); u_drop_evt = 0; end
+  endtask
+
+  // ---------------- B 部分：顶层 ----------------
+  reg reset = 1'b1;
+  reg [7:0] rx_data = 0, rx_data_b = 0;
+  reg rx_valid = 0, rx_valid_b = 0, rx_ready = 0, rx_ready_b = 0;
+  reg host_cs = 0, host_we = 0;
+  reg [15:0] host_addr = 0;
+  reg [31:0] host_wdata = 0;
+  wire [31:0] host_rdata;
+  wire host_ack;
+  AFDX_top #(.IF_MODE(0), .FCS_MODE(2)) dut (
+    .clk(clk), .reset(reset), .tx_data(), .tx_valid(), .tx_ready(),
+    .rx_data(rx_data), .rx_valid(rx_valid), .rx_ready(rx_ready),
+    .tx_data_b(), .tx_valid_b(), .tx_ready_b(),
+    .rx_data_b(rx_data_b), .rx_valid_b(rx_valid_b), .rx_ready_b(rx_ready_b),
+    .host_cs(host_cs), .host_we(host_we), .host_addr(host_addr),
+    .host_wdata(host_wdata), .host_rdata(host_rdata), .host_ack(host_ack),
+    .host_irq(), .pps_in(1'b0), .pps_out(), .rtc_time_us(), .dbg_frame_event());
+
+  task host_write;
+    input [15:0] addr; input [31:0] data;
+    begin
+      @(negedge clk); host_cs = 1; host_we = 1; host_addr = addr; host_wdata = data;
+      @(negedge clk); if (host_ack !== 1'b1) bad("host write ACK missing");
+      host_cs = 0; host_we = 0;
+    end
+  endtask
+  task host_read;
+    input [15:0] addr; output [31:0] data;
+    begin
+      @(negedge clk); host_cs = 1; host_we = 0; host_addr = addr;
+      @(negedge clk); if (host_ack !== 1'b1) bad("host read ACK missing");
+      data = host_rdata; host_cs = 0;
+    end
+  endtask
+
+  // TB 侧独立记分板：不读 RTL 计数器，只观测流水握手拍
+  integer sb_rx_frames = 0, sb_rx_bytes = 0, sb_rx_acc = 0;
+  integer sb_bkt [0:7];
+  integer sb_i;
+  always @(posedge clk) if (!reset) begin
+    if (dut.lookup_take) begin
+      sb_rx_frames = sb_rx_frames + 1;
+      sb_rx_bytes  = sb_rx_bytes + dut.lookup_in_desc[158:148];
+    end
+    if (dut.rm_fire && dut.rm_out_fwd) begin
+      sb_rx_acc = sb_rx_acc + 1;
+      sb_bkt[bucket_of(dut.rm_out_desc[158:148])] =
+        sb_bkt[bucket_of(dut.rm_out_desc[158:148])] + 1;
+    end
+  end
+  function integer bucket_of;
+    input [12:0] l;
+    begin
+      if      (l <= 13'd64)   bucket_of = 0;
+      else if (l <= 13'd128)  bucket_of = 1;
+      else if (l <= 13'd256)  bucket_of = 2;
+      else if (l <= 13'd512)  bucket_of = 3;
+      else if (l <= 13'd768)  bucket_of = 4;
+      else if (l <= 13'd1024) bucket_of = 5;
+      else if (l <= 13'd1518) bucket_of = 6;
+      else                    bucket_of = 7;
+    end
+  endfunction
+
+  localparam integer P_SAP = 5;
+  localparam [15:0] PT_SAP = 16'h7D80 + 4*P_SAP;
+  localparam [31:0] W0_VL  = 32'hF500_0000 | (P_SAP<<12) | 32'd79;
+  reg [31:0] vec [0:1144];
+  integer vec_idx, case0_base;
+  function [7:0] frame_byte;
+    input integer off; reg [31:0] q;
+    begin
+      q = vec[case0_base + (off>>2)];
+      case (off & 3) 0: frame_byte = q[31:24]; 1: frame_byte = q[23:16];
+                     2: frame_byte = q[15:8]; default: frame_byte = q[7:0]; endcase
+    end
+  endfunction
+  integer b;
+  task drive_frame;
+    begin
+      for (b = 0; b < 64; b = b + 1) begin
+        @(negedge clk); rx_ready = 1; rx_valid = 1; rx_data = frame_byte(b);
+        @(negedge clk); rx_valid = 0; repeat (8) @(negedge clk);
+      end
+      @(negedge clk); rx_ready = 0; rx_valid = 0;
+    end
+  endtask
+
+  reg [31:0] d, e;
+  integer waitc, i;
+
+  initial begin
+    for (sb_i = 0; sb_i < 8; sb_i = sb_i + 1) sb_bkt[sb_i] = 0;
+
+    // ============ A 部分 ============
+    repeat (4) @(negedge clk); u_rst = 1'b0;
+    // A1 复位清零
+    peek(8'h04,d); if (d !== 32'd0) bad("A1 RX_FRAME not zero after reset");
+    peek(8'h0B,d); if (d !== 32'd0) bad("A1 DROP_TOTAL not zero after reset");
+    peek(8'h20,d); if (d !== 32'd0) bad("A1 HIST_LEN0 not zero after reset");
+    // A2 0x00~0x03 镜像只读
+    peek(8'h00,d); if (d !== u_pb0) bad("A2 deliver mirror wrong");
+    peek(8'h01,d); if (d !== u_pb1) bad("A2 port-drop mirror wrong");
+    peek(8'h02,d); if (d !== u_pb2) bad("A2 ovr mirror wrong");
+    peek(8'h03,d); if (d !== u_pb3) bad("A2 qovf mirror wrong");
+    u_off = 8'h00; #1; if (u_wrok !== 1'b0) bad("A2 mirror must reject writes");
+    u_off = 8'h04; #1; if (u_wrok !== 1'b1) bad("A2 RX_FRAME must accept W1C");
+    // A3 帧/字节计数 + 64 bit 进位
+    rx_in(11'd64); rx_in(11'd1518); rx_in(11'd100);
+    peek(8'h04,d); if (d !== 32'd3) bad("A3 RX_FRAME count wrong");
+    peek(8'h05,d); if (d !== 32'd1682) bad("A3 RX_BYTE_LO wrong");
+    peek(8'h06,d); if (d !== 32'd0) bad("A3 RX_BYTE_HI must stay 0");
+    tx_ev(13'd1471); tx_ev(13'd8);
+    peek(8'h08,d); if (d !== 32'd2) bad("A3 TX_FRAME wrong");
+    peek(8'h09,d); if (d !== 32'd1479) bad("A3 TX_BYTE_LO wrong");
+    // A4 接受帧 + 帧长分桶 + 前 8 VL 直方图
+    rx_acc(11'd64,  12'd0, 24'd100);
+    rx_acc(11'd65,  12'd3, 24'd140);
+    rx_acc(11'd1518,12'd7, 24'd200);
+    rx_acc(11'd200, 12'd9, 24'd260);   // VL>=8：不进 VL 直方图
+    peek(8'h07,d); if (d !== 32'd4) bad("A4 RX_ACCEPT wrong");
+    peek(8'h20,d); if (d !== 32'd1) bad("A4 HIST_LEN[0] (<=64) wrong");
+    peek(8'h21,d); if (d !== 32'd1) bad("A4 HIST_LEN[1] (65..128) wrong");
+    peek(8'h22,d); if (d !== 32'd1) bad("A4 HIST_LEN[2] (129..256) wrong");
+    peek(8'h26,d); if (d !== 32'd1) bad("A4 HIST_LEN[6] (1025..1518) wrong");
+    peek(8'h28,d); if (d !== 32'd1) bad("A4 HIST_VL[0] wrong");
+    peek(8'h2B,d); if (d !== 32'd1) bad("A4 HIST_VL[3] wrong");
+    peek(8'h2F,d); if (d !== 32'd1) bad("A4 HIST_VL[7] wrong");
+    peek(8'h29,d); if (d !== 32'd0) bad("A4 HIST_VL[1] must stay 0");
+    // A5 抖动（帧间到达间隔）高水位 / 最近值
+    peek(8'h0D,d); if (d !== 32'd60) bad("A5 JIT_LAST wrong");
+    peek(8'h0C,d); if (d !== 32'd60) bad("A5 JIT_MAX wrong");
+    // A6 12 类丢弃 + 合计
+    drop_ev(12'b0000_0000_0001);       // len
+    drop_ev(12'b0000_1000_0000);       // crc
+    drop_ev(12'b1000_0000_0000);       // rm
+    drop_ev(12'b0000_1000_0001);       // 同拍两类
+    peek(8'h10,d); if (d !== 32'd2) bad("A6 DROP_K[0] len wrong");
+    peek(8'h17,d); if (d !== 32'd2) bad("A6 DROP_K[7] crc wrong");
+    peek(8'h1B,d); if (d !== 32'd1) bad("A6 DROP_K[11] rm wrong");
+    peek(8'h11,d); if (d !== 32'd0) bad("A6 DROP_K[1] dmac must stay 0 (unsourced)");
+    peek(8'h0B,d); if (d !== 32'd5) bad("A6 DROP_TOTAL wrong");
+    // A7 W1C：整字清 + 部分位清
+    uwrite(8'h04, 32'hFFFF_FFFF);
+    peek(8'h04,d); if (d !== 32'd0) bad("A7 W1C full clear failed");
+    uwrite(8'h0B, 32'h0000_0001);      // 5 & ~1 = 4
+    peek(8'h0B,d); if (d !== 32'd4) bad("A7 W1C partial clear failed");
+    uwrite(8'h0B, 32'hFFFF_FFFF);
+    // A8 同拍清零 + 事件：事件不得丢失
+    @(negedge clk); u_off = 8'h04; u_wdata = 32'hFFFF_FFFF; u_wr = 1'b1;
+                    u_rx_in_evt = 1; u_rx_in_len = 11'd70;
+    @(negedge clk); u_wr = 1'b0; u_rx_in_evt = 0;
+    peek(8'h04,d); if (d !== 32'd1) bad("A8 event lost on same-cycle clear");
+    // A9 读清语义
+    uwrite(8'h0F, 32'h1);
+    peek(8'h0F,d); if (d !== 32'h1) bad("A9 STATS_CTL readback wrong");
+    uread(8'h04,d); if (d !== 32'd1) bad("A9 read-clear must return old value");
+    peek(8'h04,d); if (d !== 32'd0) bad("A9 read-clear did not clear");
+    peek(8'h07,e); uread(8'h07,d);
+    if (d !== e) bad("A9 read-clear ACCEPT returned wrong value");
+    peek(8'h07,d); if (d !== 32'd0) bad("A9 read-clear ACCEPT did not clear");
+    // 镜像不受读清影响
+    uread(8'h00,d); if (d !== u_pb0) bad("A9 mirror changed by read-clear");
+    peek(8'h00,d); if (d !== u_pb0) bad("A9 mirror cleared by read-clear");
+    uwrite(8'h0F, 32'h0);
+    // A10 冻结（STATS_CTL[1]）与 DBG_CTRL 冻结口
+    uwrite(8'h0F, 32'h2);
+    rx_in(11'd64); peek(8'h04,d); if (d !== 32'd0) bad("A10 FREEZE_SW did not stop counting");
+    uwrite(8'h0F, 32'h0);
+    u_freeze = 1'b1; rx_in(11'd64);
+    peek(8'h04,d); if (d !== 32'd0) bad("A10 freeze input did not stop counting");
+    u_freeze = 1'b0; rx_in(11'd64);
+    peek(8'h04,d); if (d !== 32'd1) bad("A10 counting did not resume");
+    // A11 再复位清零
+    @(negedge clk); u_rst = 1'b1; repeat (3) @(negedge clk); u_rst = 1'b0;
+    peek(8'h04,d); if (d !== 32'd0) bad("A11 RX_FRAME not cleared by reset");
+    peek(8'h20,d); if (d !== 32'd0) bad("A11 HIST_LEN not cleared by reset");
+    peek(8'h0C,d); if (d !== 32'd0) bad("A11 JIT_MAX not cleared by reset");
+    peek(8'h1B,d); if (d !== 32'd0) bad("A11 DROP_K not cleared by reset");
+
+    // ============ B 部分 ============
+    $readmemh("vec/t08a_frames.hex", vec);
+    if (vec[0] !== 32'd22 || vec[1][15:0] !== 16'd64 || vec[2] !== 32'h7)
+      bad("B0 64B SAP golden fixture missing");
+    case0_base = 3;
+    vec_idx = 1;
+    repeat (7) @(negedge clk); reset = 0;
+    waitc = 0;
+    while (dut.init_done !== 1 && waitc < 26000) begin @(negedge clk); waitc = waitc + 1; end
+    if (waitc >= 26000) bad("B0 INIT_DONE timeout");
+    // B1 复位后整页为 0（除 0x00~0x03 镜像）
+    for (i = 4; i < 16; i = i + 1) begin
+      host_read(16'h0100 + i[15:0], d);
+      if (d !== 32'd0) bad("B1 stats word not zero after reset");
+    end
+    host_read(16'h0140, d); if (d !== 32'd0) bad("B1 unmapped page word must read 0");
+    host_read(16'h0010, d); if (d[0] !== 1'b0) bad("B1 page read set ERR.ACC");
+    // B2 统计页 W1C 写不置 ERR.ACC；只读镜像写置 ERR.ACC
+    host_write(16'h0104, 32'hFFFF_FFFF);
+    host_read(16'h0010, d); if (d[0] !== 1'b0) bad("B2 legal stats W1C set ERR.ACC");
+    host_write(16'h0100, 32'hFFFF_FFFF);
+    host_read(16'h0010, d); if (d[0] !== 1'b1) bad("B2 RO mirror write did not set ERR.ACC");
+    host_write(16'h0010, 32'h1);
+    host_read(16'h0010, d); if (d[0] !== 1'b0) bad("B2 ERR.ACC W1C failed");
+    // B3 配置并放一帧真实 64 B 金标帧
+    host_write(16'h0008, 32'h2000);
+    host_write(16'h0078, 32'h172D); host_write(16'h007C, 32'hAB61);
+    host_write(16'h42B2, 32'h1010_0100); host_write(16'h0080, 32'h1);
+    host_write(16'h1F80, W0_VL); host_write(16'h1F81, 32'h0000_0100);
+    host_write(PT_SAP,   32'h8006_0000); host_write(PT_SAP+1, 32'h0000_1388);
+    host_write(PT_SAP+2, 32'd0);         host_write(PT_SAP+3, 32'd1);
+    host_write(16'h0008, 32'h051E);
+    drive_frame();
+    waitc = 0;
+    while (dut.mgmt_accept_cnt < 1 && waitc < 20000) begin @(negedge clk); waitc = waitc + 1; end
+    if (waitc >= 20000) bad("B3 frame never reached SAP handoff");
+    repeat (40) @(negedge clk);
+    if (sb_rx_frames !== 1) bad("B3 scoreboard expected exactly one pipeline frame");
+    host_read(16'h0104, d);
+    if (d !== sb_rx_frames[31:0]) bad("B3 RX_FRAME_CNT != TB scoreboard");
+    host_read(16'h0105, d);
+    if (d !== sb_rx_bytes[31:0]) bad("B3 RX_BYTE_LO != TB scoreboard");
+    host_read(16'h0107, d);
+    if (d !== sb_rx_acc[31:0]) bad("B3 RX_ACCEPT != TB scoreboard");
+    if (sb_rx_acc != 1) bad("B3 expected exactly one RM forward");
+    host_read(16'h0120 + bucket_of(64), d);
+    if (d !== 32'd1) bad("B3 frame-length histogram bucket not incremented");
+    // 0x00~0x03 既有口径不变（SAP 帧不进端口面）
+    host_read(16'h0100, d); if (d !== 32'd0) bad("B3 legacy deliver mirror changed");
+    host_read(16'h0101, d); if (d !== 32'd0) bad("B3 legacy port-drop mirror changed");
+    // B4 顶层 W1C 与读清
+    host_write(16'h0104, 32'hFFFF_FFFF);
+    host_read(16'h0104, d); if (d !== 32'd0) bad("B4 top-level W1C failed");
+    host_write(16'h010F, 32'h1);
+    host_read(16'h0107, d); if (d !== sb_rx_acc[31:0]) bad("B4 read-clear returned wrong value");
+    host_read(16'h0107, d); if (d !== 32'd0) bad("B4 read-clear did not clear at top level");
+    host_write(16'h010F, 32'h0);
+    // B5 顶层复位清零
+    reset = 1; repeat (7) @(negedge clk); reset = 0;
+    waitc = 0;
+    while (dut.init_done !== 1 && waitc < 26000) begin @(negedge clk); waitc = waitc + 1; end
+    host_read(16'h0105, d); if (d !== 32'd0) bad("B5 RX_BYTE not cleared by reset");
+    host_read(16'h0120, d); if (d !== 32'd0) bad("B5 histogram not cleared by reset");
+
+    if (errors == 0)
+      $display("T14 STATS PASS (unit: frame/byte/drop12/hist8+vl8/W1C/read-clear/freeze/reset; top: page RW, 1 real frame, bytes=%0d, scoreboard match)", sb_rx_bytes);
+    else
+      $display("T14 STATS FAIL (errors=%0d)", errors);
+    $finish;
+  end
+  initial begin
+    #60_000_000; $display("T14 STATS FAIL: timeout"); $finish;
+  end
+endmodule
### sim/tb/tb_t15_snmp.v  [new file (continue4)]
--- a/sim/tb/tb_t15_snmp.v
+++ b/sim/tb/tb_t15_snmp.v
@@ -0,0 +1,446 @@
+// =====================================================================
+// T15 —— snmp_lite（GET / GETNEXT / SET + STATS_BLOCK 只读组）
+// 请求 PDU 全部来自 sw/golden/gen_t15_vectors.py 生成的真实 SAP 帧
+// （ETH/IP/UDP + AFDX SN + zlib 线序 FCS），TB 侧自己做 BER 解码来校验响应。
+//   A 部分：把金标帧的 UDP 载荷直接灌进 snmp_lite 单元，逐条校验
+//           响应 PDU 的 BER 结构、request-id 回抄、error-status/index、
+//           VarBind 的 OID 与值编码。
+//   B 部分：同样的帧真的走线 → mac_rx_if → 解析 → mgmt_sap_rx 取 PMEM
+//           载荷 → snmp_lite，主机经 0xAC14~0xAC1F 观测窗读响应字节。
+// 边界：响应只编码并经观测窗读出，未接入 TX 帧构建器（管理面回包不上线）。
+// =====================================================================
+`timescale 1 ns / 1 ps
+module tb_t15_snmp;
+  integer errors = 0;
+  reg clk = 0;
+  always #4 clk = ~clk;
+  task bad;
+    input [8*110-1:0] reason;
+    begin if (errors < 30) $display("  [err] T15: %0s", reason); errors = errors + 1; end
+  endtask
+  task badv;
+    input [8*90-1:0] reason; input [31:0] got; input [31:0] want;
+    begin
+      if (errors < 30) $display("  [err] T15: %0s (got=%0h want=%0h)", reason, got, want);
+      errors = errors + 1;
+    end
+  endtask
+
+  // ---------------- 金标帧 ----------------
+  reg [31:0] vec [0:2047];
+  integer cbase [0:31];
+  integer clen  [0:31];
+  integer cplen [0:31];
+  integer ncase, vi2, cid, i, k, b, waitc;
+  function [7:0] fbyte; input integer c; input integer off;
+    reg [31:0] q;
+    begin
+      q = vec[cbase[c] + (off>>2)];
+      case (off & 3) 0: fbyte=q[31:24]; 1: fbyte=q[23:16];
+                     2: fbyte=q[15:8];  default: fbyte=q[7:0]; endcase
+    end
+  endfunction
+  function [7:0] pbyte;                 // 用例 c 的第 j 个 UDP 载荷字节
+    input integer c; input integer j;
+    begin pbyte = fbyte(c, 42 + j); end
+  endfunction
+
+  // ---------------- 响应缓存与 BER 解码 ----------------
+  reg [7:0] rb [0:255];
+  integer rlen;
+  integer r_err, r_idx, r_nvb, r_rid, r_ver, r_comm;
+  integer vbg [0:7];
+  integer vbl [0:7];
+  integer vbt [0:7];
+  integer vbn [0:7];
+  integer vbv [0:7];
+  integer vbp [0:7];
+  integer pp, ln, ol, vl, stop, jj;
+  function [7:0] pfx; input integer j;
+    begin
+      case (j) 0:pfx=8'h2B;1:pfx=8'h06;2:pfx=8'h01;3:pfx=8'h04;
+               4:pfx=8'h01;5:pfx=8'hA2;6:pfx=8'h5C;7:pfx=8'h01; default:pfx=8'h00; endcase
+    end
+  endfunction
+  function [7:0] dch; input integer j;
+    begin
+      case (j) 0:dch="A";1:dch="F";2:dch="D";3:dch="X";4:dch="-";5:dch="E";
+               6:dch="S";7:dch=" ";8:dch="e";9:dch="L";10:dch="i";11:dch="n";
+               12:dch="x";13:dch=" ";14:dch="v";15:dch="1"; default:dch=8'h20; endcase
+    end
+  endfunction
+  task get_len;                          // 短式 / 0x81 长式
+    begin
+      if (rb[pp] < 8'h80) begin ln = rb[pp]; pp = pp + 1; end
+      else if (rb[pp] == 8'h81) begin ln = rb[pp+1]; pp = pp + 2; end
+      else begin bad("response used an unsupported long-form length"); ln = 0; pp = pp + 2; end
+    end
+  endtask
+  task decode;
+    begin
+      r_err = -1; r_idx = -1; r_nvb = 0; r_rid = 0; r_ver = -1; r_comm = 0;
+      pp = 0;
+      if (rb[0] !== 8'h30) bad("response is not a BER SEQUENCE");
+      pp = 1; get_len;
+      if ((pp + ln) !== rlen) badv("outer SEQUENCE length wrong", pp+ln, rlen);
+      if (rb[pp] !== 8'h02 || rb[pp+1] !== 8'd1) bad("version TLV malformed");
+      r_ver = rb[pp+2]; pp = pp + 3;
+      if (rb[pp] !== 8'h04) bad("community TLV malformed");
+      r_comm = rb[pp+1]; pp = pp + 2;
+      if (r_comm !== 6) bad("community must be echoed as 6 bytes");
+      if (rb[pp] !== "p" || rb[pp+1] !== "u" || rb[pp+2] !== "b" ||
+          rb[pp+3] !== "l" || rb[pp+4] !== "i" || rb[pp+5] !== "c")
+        bad("community not echoed verbatim");
+      pp = pp + r_comm;
+      if (rb[pp] !== 8'hA2) badv("PDU type must be GetResponse", {24'd0,rb[pp]}, 32'hA2);
+      pp = pp + 1; get_len;
+      if (rb[pp] !== 8'h02) bad("request-id TLV malformed");
+      ol = rb[pp+1]; pp = pp + 2;
+      for (jj = 0; jj < ol; jj = jj + 1) r_rid = (r_rid << 8) | rb[pp+jj];
+      pp = pp + ol;
+      if (rb[pp] !== 8'h02 || rb[pp+1] !== 8'd1) bad("error-status TLV malformed");
+      r_err = rb[pp+2]; pp = pp + 3;
+      if (rb[pp] !== 8'h02 || rb[pp+1] !== 8'd1) bad("error-index TLV malformed");
+      r_idx = rb[pp+2]; pp = pp + 3;
+      if (rb[pp] !== 8'h30) bad("varbind-list TLV malformed");
+      pp = pp + 1; get_len;
+      stop = pp + ln;
+      while (pp < stop && r_nvb < 8) begin
+        if (rb[pp] !== 8'h30) bad("varbind TLV malformed");
+        pp = pp + 1; get_len;
+        if (rb[pp] !== 8'h06) bad("OID TLV malformed");
+        ol = rb[pp+1]; pp = pp + 2;
+        if (ol !== 11) badv("OID length must be 11", ol, 11);
+        for (jj = 0; jj < 8; jj = jj + 1)
+          if (rb[pp+jj] !== pfx(jj)) bad("enterprise OID prefix wrong");
+        vbg[r_nvb] = rb[pp+8];
+        vbl[r_nvb] = rb[pp+9];
+        if (rb[pp+10] !== 8'h00) bad("OID instance sub-id must be 0");
+        pp = pp + ol;
+        vbt[r_nvb] = rb[pp];
+        vl = rb[pp+1];
+        vbn[r_nvb] = vl;
+        pp = pp + 2;
+        vbp[r_nvb] = pp;
+        vbv[r_nvb] = 0;
+        for (jj = 0; jj < vl && jj < 4; jj = jj + 1) vbv[r_nvb] = (vbv[r_nvb] << 8) | rb[pp+jj];
+        pp = pp + vl;
+        r_nvb = r_nvb + 1;
+      end
+      if (pp !== stop) bad("varbind list did not consume exactly its length");
+    end
+  endtask
+
+  // ================= A：snmp_lite 单元级 =================
+  reg        s_rst = 1'b1;
+  reg        s_vld = 0, s_sop = 0, s_eop = 0;
+  reg [7:0]  s_data = 0;
+  reg [15:0] s_sport = 16'd49152;
+  reg [31:0] s_uptime = 32'h0001_2345;
+  reg [15:0] s_ctl = 16'h051C;
+  reg [31:0] s_drop = 32'h0000_00AB, s_jit = 32'h0000_1F40, s_buf = 32'd6;
+  reg        s_rack = 0;
+  reg [10:0] s_raddr = 0;
+  wire [7:0]  s_off;
+  wire [31:0] s_sdata = 32'h1000_0000 + {24'd0, s_off};
+  wire        s_ctlwe;
+  wire [15:0] s_ctlwd;
+  wire        s_rvld;
+  wire [10:0] s_rlen;
+  wire [7:0]  s_rbyte;
+  wire [31:0] s_rx, s_tx, s_drp;
+  wire [3:0]  s_e, s_ix, s_vbn;
+  wire [7:0]  s_pdu;
+  wire [15:0] s_peer;
+  snmp_lite #(.NUM_TX_VL(128), .NUM_RX_VL(4096), .MAX_VB(8)) sut (
+    .clk(clk), .rst_sync(s_rst), .en(1'b1),
+    .in_vld(s_vld), .in_sop(s_sop), .in_eop(s_eop), .in_data(s_data),
+    .in_sport(s_sport), .in_ready(),
+    .uptime_cs(s_uptime), .ctl_val(s_ctl), .drop_total(s_drop),
+    .jit_max_us(s_jit), .buf_util(s_buf),
+    .stats_off(s_off), .stats_data(s_sdata),
+    .ctl_we(s_ctlwe), .ctl_wdata(s_ctlwd),
+    .resp_vld(s_rvld), .resp_len(s_rlen), .resp_ack(s_rack),
+    .resp_rd_addr(s_raddr), .resp_byte(s_rbyte),
+    .rx_pdu_cnt(s_rx), .resp_cnt(s_tx), .drop_pdu_cnt(s_drp),
+    .last_err(s_e), .last_idx(s_ix), .last_pdu(s_pdu), .peer_port(s_peer),
+    .vb_n(s_vbn), .state_o());
+  always @(posedge clk) if (!s_rst && s_ctlwe) s_ctl <= s_ctlwd;
+
+  task u_send; input integer c;
+    begin
+      for (i = 0; i < cplen[c]; i = i + 1) begin
+        @(negedge clk);
+        s_vld = 1; s_sop = (i == 0); s_eop = (i == cplen[c]-1); s_data = pbyte(c, i);
+      end
+      @(negedge clk); s_vld = 0; s_sop = 0; s_eop = 0;
+      waitc = 0;
+      while (s_rvld !== 1'b1 && waitc < 4000) begin @(negedge clk); waitc = waitc + 1; end
+    end
+  endtask
+  task u_grab;                       // 取回响应并解码
+    begin
+      if (s_rvld !== 1'b1) begin bad("unit: no response produced"); rlen = 0; end
+      else begin
+        rlen = s_rlen;
+        for (i = 0; i < rlen; i = i + 1) begin s_raddr = i[10:0]; #1; rb[i] = s_rbyte; end
+        decode;
+        @(negedge clk); s_rack = 1; @(negedge clk); s_rack = 0;
+      end
+    end
+  endtask
+
+  // ================= B：顶层 =================
+  reg reset = 1'b1;
+  reg [7:0] rx_data = 0, rx_data_b = 0;
+  reg rx_valid = 0, rx_valid_b = 0, rx_ready = 0, rx_ready_b = 0;
+  reg host_cs = 0, host_we = 0;
+  reg [15:0] host_addr = 0;
+  reg [31:0] host_wdata = 0;
+  wire [31:0] host_rdata;
+  wire host_ack;
+  AFDX_top #(.IF_MODE(0), .FCS_MODE(2), .SNMP_SAP_PORT(5), .TFTP_SAP_PORT(9)) dut (
+    .clk(clk), .reset(reset), .tx_data(), .tx_valid(), .tx_ready(),
+    .rx_data(rx_data), .rx_valid(rx_valid), .rx_ready(rx_ready),
+    .tx_data_b(), .tx_valid_b(), .tx_ready_b(),
+    .rx_data_b(rx_data_b), .rx_valid_b(rx_valid_b), .rx_ready_b(rx_ready_b),
+    .host_cs(host_cs), .host_we(host_we), .host_addr(host_addr),
+    .host_wdata(host_wdata), .host_rdata(host_rdata), .host_ack(host_ack),
+    .host_irq(), .pps_in(1'b0), .pps_out(), .rtc_time_us(), .dbg_frame_event());
+  task host_write; input [15:0] a; input [31:0] d;
+    begin
+      @(negedge clk); host_cs=1; host_we=1; host_addr=a; host_wdata=d;
+      @(negedge clk); if (host_ack !== 1'b1) bad("host write ACK missing");
+      host_cs=0; host_we=0;
+    end
+  endtask
+  task host_read; input [15:0] a; output [31:0] d;
+    begin
+      @(negedge clk); host_cs=1; host_we=0; host_addr=a;
+      @(negedge clk); if (host_ack !== 1'b1) bad("host read ACK missing");
+      d = host_rdata; host_cs=0;
+    end
+  endtask
+  localparam integer P_SAP = 5;
+  localparam [15:0] PT_SAP = 16'h7D80 + 4*P_SAP;
+  localparam [31:0] W0_VL  = 32'hF500_0000 | (P_SAP<<12) | 32'd700;
+  reg [31:0] d, e;
+  integer acc0;
+  task drive_case; input integer c;
+    begin
+      acc0 = dut.mgmt_accept_cnt;
+      for (b = 0; b < clen[c]; b = b + 1) begin
+        @(negedge clk); rx_ready=1; rx_valid=1; rx_data=fbyte(c,b);
+        @(negedge clk); rx_valid=0; repeat (8) @(negedge clk);
+      end
+      @(negedge clk); rx_ready=0; rx_valid=0;
+      waitc = 0;
+      while (dut.mgmt_accept_cnt <= acc0 && waitc < 20000) begin
+        @(negedge clk); waitc = waitc + 1;
+      end
+      if (waitc >= 20000) bad("SAP endpoint never accepted the frame");
+      waitc = 0;
+      while (dut.u_mgmt_sap.st !== 2'd0 && waitc < 8000) begin
+        @(negedge clk); waitc = waitc + 1;
+      end
+      repeat (400) @(negedge clk);
+    end
+  endtask
+  task t_grab;                       // 顶层经观测窗取回响应并解码
+    reg [31:0] w;
+    begin
+      host_read(16'hAC1C, w);
+      if (w[0] !== 1'b1) begin bad("top: no SNMP response queued"); rlen = 0; end
+      else begin
+        host_read(16'hAC15, w); rlen = w[10:0];
+        for (i = 0; i < rlen; i = i + 1) begin
+          host_write(16'hAC1A, i[31:0]);
+          host_read(16'hAC1B, w);
+          rb[i] = w[7:0];
+        end
+        decode;
+        host_write(16'hAC1C, 32'd1);
+      end
+    end
+  endtask
+
+  initial begin
+    $readmemh("vec/t15_mgmt.hex", vec);
+    ncase = vec[0];
+    if (ncase < 22) bad("A0 management golden vectors missing");
+    vi2 = 1;
+    for (i = 0; i < ncase; i = i + 1) begin
+      cid = vec[vi2][31:24];
+      clen[cid]  = vec[vi2][15:0];
+      cplen[cid] = vec[vi2+1];
+      cbase[cid] = vi2 + 3;
+      vi2 = vi2 + 3 + (vec[vi2][15:0] + 3) / 4;
+    end
+
+    // ---------------- A ----------------
+    repeat (4) @(negedge clk); s_rst = 1'b0;
+    // A1 GET afdxEsUpTime（TimeTicks）
+    u_send(10); u_grab;
+    if (r_err !== 0 || r_idx !== 0) badv("A1 GET must succeed", r_err, 0);
+    if (r_rid !== 32'h11223344) badv("A1 request-id not echoed", r_rid, 32'h11223344);
+    if (r_ver !== 0) bad("A1 version must be echoed as v1(0)");
+    if (r_nvb !== 1) badv("A1 varbind count", r_nvb, 1);
+    if (vbg[0] !== 1 || vbl[0] !== 2) bad("A1 OID not echoed");
+    if (vbt[0] !== 8'h43) badv("A1 upTime must be TimeTicks(0x43)", vbt[0], 8'h43);
+    if (vbv[0] !== s_uptime) badv("A1 upTime value", vbv[0], s_uptime);
+    // A2 GETNEXT 从标量组末项走到 STATS_BLOCK 组首项
+    u_send(11); u_grab;
+    if (r_err !== 0) bad("A2 GETNEXT must succeed");
+    if (vbg[0] !== 2 || vbl[0] !== 0) bad("A2 GETNEXT must step into the STATS_BLOCK group");
+    if (vbt[0] !== 8'h41) bad("A2 STATS_BLOCK objects must be Counter32");
+    if (vbv[0] !== 32'h1000_0000) badv("A2 STATS_BLOCK value", vbv[0], 32'h1000_0000);
+    // A3 SET afdxEsCtl（唯一可写对象）
+    u_send(12); u_grab;
+    if (r_err !== 0 || r_idx !== 0) badv("A3 SET must succeed", r_err, 0);
+    if (vbv[0] !== 32'h1234) badv("A3 SET must echo the new value", vbv[0], 32'h1234);
+    if (s_ctl !== 16'h1234) badv("A3 SET did not reach the control shadow", {16'd0,s_ctl}, 32'h1234);
+    // A4 GET 回读 SET 结果
+    u_send(13); u_grab;
+    if (vbv[0] !== 32'h1234) badv("A4 GET after SET", vbv[0], 32'h1234);
+    if (vbt[0] !== 8'h02) bad("A4 esCtl must be INTEGER");
+    // A5 GET 不存在的对象 → noSuchName(2)
+    u_send(14); u_grab;
+    if (r_err !== 2) badv("A5 unknown OID must return noSuchName(2)", r_err, 2);
+    if (r_idx !== 1) badv("A5 error-index must point at varbind 1", r_idx, 1);
+    if (vbt[0] !== 8'h05 || vbn[0] !== 0) bad("A5 error response must carry NULL values");
+    // A6 SET 只读对象 → readOnly(4)
+    u_send(15); u_grab;
+    if (r_err !== 4) badv("A6 SET to RO must return readOnly(4)", r_err, 4);
+    if (r_idx !== 1) bad("A6 error-index wrong");
+    // A7 community 不符 → 静默丢弃
+    e = s_drp; d = s_tx;
+    u_send(16);
+    repeat (40) @(negedge clk);
+    if (s_rvld === 1'b1) bad("A7 wrong community must not be answered");
+    if (s_drp !== (e + 32'd1)) badv("A7 drop counter did not advance", s_drp, e+32'd1);
+    if (s_tx !== d) bad("A7 response counter must not advance");
+    // A8 多 VarBind：两个 STATS_BLOCK 字
+    u_send(17); u_grab;
+    if (r_err !== 0) bad("A8 multi-varbind GET must succeed");
+    if (r_nvb !== 2) badv("A8 varbind count", r_nvb, 2);
+    if (vbg[0] !== 2 || vbl[0] !== 4) bad("A8 varbind 1 OID wrong");
+    if (vbg[1] !== 2 || vbl[1] !== 7) bad("A8 varbind 2 OID wrong");
+    if (vbv[0] !== 32'h1000_0004 || vbv[1] !== 32'h1000_0007) bad("A8 STATS_BLOCK values wrong");
+    // A9 OCTET STRING 对象
+    u_send(18); u_grab;
+    if (vbt[0] !== 8'h04) bad("A9 descr must be OCTET STRING");
+    if (vbn[0] !== 16) badv("A9 descr length", vbn[0], 16);
+    for (i = 0; i < 16; i = i + 1)
+      if (rb[vbp[0]+i] !== dch(i)) bad("A9 descr string content wrong");
+    // A10 SET 类型不符 → badValue(3)
+    u_send(19); u_grab;
+    if (r_err !== 3) badv("A10 SET with wrong type must return badValue(3)", r_err, 3);
+    if (s_ctl !== 16'h1234) bad("A10 rejected SET must not change the object");
+    // A11 三 VarBind 标量组
+    u_send(20); u_grab;
+    if (r_nvb !== 3) badv("A11 varbind count", r_nvb, 3);
+    if (vbv[0] !== 32'd128) badv("A11 numTxVl", vbv[0], 32'd128);
+    if (vbv[1] !== 32'd4096) badv("A11 numRxVl", vbv[1], 32'd4096);
+    if (vbt[2] !== 8'h42) bad("A11 bufUtil must be Gauge32");
+    if (vbv[2] !== s_buf) badv("A11 bufUtil value", vbv[2], s_buf);
+    // A12 GETNEXT 走出 MIB 末尾 → noSuchName(2)
+    u_send(21); u_grab;
+    if (r_err !== 2) badv("A12 GETNEXT past end must return noSuchName(2)", r_err, 2);
+    // A13 计数器自洽
+    if (s_rx !== 32'd12) badv("A13 rx_pdu_cnt", s_rx, 32'd12);
+    if (s_tx !== 32'd11) badv("A13 resp_cnt", s_tx, 32'd11);
+    if (s_drp !== 32'd1) badv("A13 drop_pdu_cnt", s_drp, 32'd1);
+
+    // ---------------- B ----------------
+    repeat (7) @(negedge clk); reset = 0;
+    waitc = 0;
+    while (dut.init_done !== 1 && waitc < 26000) begin @(negedge clk); waitc = waitc + 1; end
+    if (waitc >= 26000) bad("B0 INIT_DONE timeout");
+    host_write(16'h0008, 32'h2000);
+    host_write(16'h0078, 32'h172D); host_write(16'h007C, 32'hAB61);
+    host_write(16'h42B2, 32'h1010_0100); host_write(16'h0080, 32'h1);
+    host_write(16'h1F80, W0_VL); host_write(16'h1F81, 32'h0000_0100);
+    host_write(PT_SAP,   32'h8006_0000); host_write(PT_SAP+1, 32'h0000_1388);
+    host_write(PT_SAP+2, 32'd0);         host_write(PT_SAP+3, 32'd1);
+    host_write(16'h0008, 32'h051E);
+    // 注意：IC 要求同一 VL 的 SN 严格递增，因此 B 段必须按金标帧的 SN 顺序
+    // （用例 10..21 对应 SN 0..11）逐条上线，不能跳着发。
+    // B1 GET afdxEsUpTime
+    drive_case(10); t_grab;
+    if (r_err !== 0) bad("B1 on-wire GET failed");
+    if (r_rid !== 32'h11223344) bad("B1 on-wire request-id not echoed");
+    if (vbg[0] !== 1 || vbl[0] !== 2) bad("B1 on-wire OID wrong");
+    if (vbt[0] !== 8'h43) bad("B1 on-wire upTime must be TimeTicks");
+    if (vbv[0] !== dut.uptime_cs) badv("B1 upTime differs from the core counter",
+                                        vbv[0], dut.uptime_cs);
+    host_read(16'hAC14, d);
+    if (d[19:12] !== 8'hA0) badv("B1 last PDU type", {24'd0,d[19:12]}, 32'hA0);
+    if (d[11:8] !== 4'd1) bad("B1 varbind count in status word");
+    host_read(16'hAC1E, d);
+    if (d[15:0] !== 16'hC000) badv("B1 SAP source port wrong", d, 32'hC000);
+    host_read(16'hAC1F, d);
+    if (d !== 32'h0A00_0001) badv("B1 SAP source IP wrong", d, 32'h0A00_0001);
+    host_read(16'hAC1D, d);
+    if (d[15:0] !== 16'd5000) badv("B1 SAP dest port wrong", d, 32'd5000);
+    // B2 GETNEXT 跨组
+    drive_case(11); t_grab;
+    if (r_err !== 0 || vbg[0] !== 2 || vbl[0] !== 0)
+      bad("B2 on-wire GETNEXT must step into STATS_BLOCK");
+    // B3 SET / 回读
+    drive_case(12); t_grab;
+    if (r_err !== 0 || vbv[0] !== 32'h1234) bad("B3 on-wire SET failed");
+    drive_case(13); t_grab;
+    if (vbv[0] !== 32'h1234) bad("B3 on-wire GET after SET wrong");
+    if (dut.snmp_ctl_shadow !== 16'h1234) bad("B3 control shadow not updated");
+    // B4 三种错误码
+    drive_case(14); t_grab;
+    if (r_err !== 2 || r_idx !== 1) badv("B4 on-wire noSuchName wrong", r_err, 2);
+    drive_case(15); t_grab;
+    if (r_err !== 4) badv("B4 on-wire readOnly wrong", r_err, 4);
+    // B5 community 不符：静默丢弃
+    host_read(16'hAC18, e);
+    drive_case(16);
+    host_read(16'hAC1C, d);
+    if (d[0] !== 1'b0) bad("B5 bad community must not produce a response");
+    host_read(16'hAC18, d);
+    if (d !== (e + 32'd1)) badv("B5 drop counter did not advance", d, e+32'd1);
+    // B6 STATS_BLOCK 只读组必须直通全局统计页
+    drive_case(17); t_grab;
+    if (r_err !== 0 || r_nvb !== 2) bad("B6 on-wire STATS_BLOCK GET failed");
+    host_read(16'h0104, d);
+    if (vbv[0] !== d) badv("B6 STATS_BLOCK word 4 != stats page", vbv[0], d);
+    host_read(16'h0107, e);
+    if (vbv[1] !== e) badv("B6 STATS_BLOCK word 7 != stats page", vbv[1], e);
+    if (d === 32'd0) bad("B6 RX frame counter should be non-zero after real traffic");
+    // B7 OCTET STRING / badValue / 多 VarBind / 走到表尾
+    drive_case(18); t_grab;
+    if (vbt[0] !== 8'h04 || vbn[0] !== 16) bad("B7 on-wire descr encoding wrong");
+    for (i = 0; i < 16; i = i + 1)
+      if (rb[vbp[0]+i] !== dch(i)) bad("B7 on-wire descr content wrong");
+    drive_case(19); t_grab;
+    if (r_err !== 3) badv("B7 on-wire badValue wrong", r_err, 3);
+    drive_case(20); t_grab;
+    if (r_nvb !== 3 || vbv[0] !== 32'd128 || vbv[1] !== 32'd4096)
+      bad("B7 on-wire three-varbind GET wrong");
+    drive_case(21); t_grab;
+    if (r_err !== 2) badv("B7 on-wire GETNEXT past end wrong", r_err, 2);
+    // B8 守恒与计数
+    if (dut.rx_free_map !== 16'hFFC0) bad("B8 SAP blocks not returned to RX pool");
+    host_read(16'hAC10, e); host_read(16'hAC11, d);
+    if (d !== e) bad("B8 SAP accept/return counters diverged");
+    if (e !== 32'd12) badv("B8 SAP accept count", e, 32'd12);
+    host_read(16'hAC16, d);
+    if (d !== 32'd12) badv("B8 on-wire rx_pdu_cnt", d, 32'd12);
+    host_read(16'hAC17, d);
+    if (d !== 32'd11) badv("B8 on-wire resp_cnt", d, 32'd11);
+
+    if (errors == 0)
+      $display("T15 SNMP PASS (unit: 12 real BER PDUs, GET/GETNEXT/SET, STATS_BLOCK, noSuchName/readOnly/badValue/community-drop, OCTET STRING, multi-varbind; top: 12 on-wire SAP frames decoded, 11 answered, 1 dropped on community)");
+    else
+      $display("T15 SNMP FAIL (errors=%0d)", errors);
+    $finish;
+  end
+  initial begin
+    #300_000_000; $display("T15 SNMP FAIL: timeout"); $finish;
+  end
+endmodule
### sim/tb/tb_t16_tftp_rtc.v  [new file (continue4)]
--- a/sim/tb/tb_t16_tftp_rtc.v
+++ b/sim/tb/tb_t16_tftp_rtc.v
@@ -0,0 +1,492 @@
+// =====================================================================
+// T16 —— A615-A TFTP 引擎 + RTC/PPS 对时
+// A 部分（单元级 a615a_tftp）：WRQ/DATA/ACK/ERROR/RRQ 真实报文字节流，
+//   校验 ACK 编码、加载区落盘内容、CRC32、重复块、错块、白名单、mode、
+//   RRQ STATUS 文件、非法操作码、超时重传与重试上限。
+// B 部分（单元级 rtc_sync）：自由运行 PPS 周期、大误差跳变、小误差平滑、
+//   锁定判据、失步看门狗、HOLD。
+// C 部分（顶层）：真实 SAP 帧（vec/t15_mgmt.hex，含线序 FCS）经 mac_rx_if
+//   → 解析 → mgmt_sap_rx 取回 PMEM 载荷 → a615a_tftp，主机经 0xAC20~0xAC29
+//   观测窗读状态与响应字节，经 0xCC20 加载区回读落盘数据。
+// 边界：管理面响应只编码并经观测窗读出，未接入 TX 帧构建器（不上线）。
+// =====================================================================
+`timescale 1 ns / 1 ps
+module tb_t16_tftp_rtc;
+  integer errors = 0;
+  reg clk = 0;
+  always #4 clk = ~clk;
+  task bad;
+    input [8*110-1:0] reason;
+    begin if (errors < 30) $display("  [err] T16: %0s", reason); errors = errors + 1; end
+  endtask
+  task badv;
+    input [8*90-1:0] reason; input [31:0] got; input [31:0] want;
+    begin
+      if (errors < 30) $display("  [err] T16: %0s (got=%0h want=%0h)", reason, got, want);
+      errors = errors + 1;
+    end
+  endtask
+  function [31:0] crc32b;                      // 反射 CRC-32 参考实现
+    input [31:0] c0; input [7:0] d;
+    reg [31:0] c; integer k;
+    begin
+      c = c0 ^ {24'd0, d};
+      for (k = 0; k < 8; k = k + 1) c = c[0] ? ((c >> 1) ^ 32'hEDB88320) : (c >> 1);
+      crc32b = c;
+    end
+  endfunction
+
+  // ================= A：a615a_tftp 单元级 =================
+  reg        t_rst = 1'b1, t_tick = 1'b0;
+  reg        t_vld = 0, t_sop = 0, t_eop = 0;
+  reg [7:0]  t_data = 0;
+  reg [15:0] t_sport = 16'd4096;
+  reg        t_rack = 0;
+  reg [10:0] t_raddr = 0;
+  reg        t_hrd = 0;
+  reg [12:0] t_haddr = 0;
+  wire        t_rdy, t_rvld, t_ok;
+  wire [10:0] t_rlen;
+  wire [7:0]  t_rbyte, t_retry;
+  wire [31:0] t_hdata, t_bytes, t_crc, t_pkt, t_dup, t_ecnt, t_to, t_fnh;
+  wire [15:0] t_err, t_tid, t_blk;
+  wire [3:0]  t_st;
+  a615a_tftp #(.LOAD_WORDS(8192), .RETRY_MAX(3), .TIMEOUT_US(50)) tut (
+    .clk(clk), .rst_sync(t_rst), .en(1'b1), .tick_us(t_tick),
+    .in_vld(t_vld), .in_sop(t_sop), .in_eop(t_eop), .in_data(t_data),
+    .in_sport(t_sport), .in_ready(t_rdy),
+    .resp_vld(t_rvld), .resp_len(t_rlen), .resp_ack(t_rack),
+    .resp_rd_addr(t_raddr), .resp_byte(t_rbyte),
+    .host_rd(t_hrd), .host_addr(t_haddr), .host_rdata(t_hdata),
+    .loaded_ok(t_ok), .err_code(t_err), .tid(t_tid), .blk_expect(t_blk),
+    .bytes_rcvd(t_bytes), .crc32_val(t_crc), .pkt_cnt(t_pkt), .dup_cnt(t_dup),
+    .err_cnt(t_ecnt), .timeout_cnt(t_to), .retry_cnt(t_retry),
+    .fname_head(t_fnh), .state_o(t_st));
+
+  reg [7:0] pkt [0:1023];
+  integer pktlen, pi;
+  task send_pkt;
+    begin
+      for (pi = 0; pi < pktlen; pi = pi + 1) begin
