+    P_COMT=6,  P_COML=7,  P_COMB=8,  P_PDUT=9,  P_PDUL=10, P_RIDT=11,
+    P_RIDL=12, P_RIDB=13, P_EST=14,  P_ESL=15,  P_ESV=16,  P_EIT=17,
