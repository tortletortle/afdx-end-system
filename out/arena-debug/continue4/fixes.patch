+    end
+  endfunction
+  // ---- 文件名白名单："UPLOAD" / "STATUS" ----
+  function [7:0] wl0; input [4:0] k;
+    begin case (k) 0:wl0="U"; 1:wl0="P"; 2:wl0="L"; 3:wl0="O"; 4:wl0="A"; 5:wl0="D";
