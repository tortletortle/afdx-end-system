+  input  wire [31:0] uptime_cs,
+  input  wire [15:0] ctl_val,
+  input  wire [31:0] drop_total,
+  input  wire [31:0] jit_max_us,
+  input  wire [31:0] buf_util,
+  output wire [7:0]  stats_off,
+  input  wire [31:0] stats_data,
