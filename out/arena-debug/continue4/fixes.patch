+module stats_regs (
+  input  wire        clk,
+  input  wire        rst_sync,
+  input  wire        freeze,            // DBG_CTRL[6]：冻结统计更新
+
+  // ---- RX 入口事件：一帧好帧进入查表级 ----
+  input  wire        rx_in_evt,
+  input  wire [10:0] rx_in_len,
+
+  // ---- RX 接受事件：RM forward 握手拍 ----
