-  // TODO: 端口按 §7.16 信号表（与 TB 的唯一接口是顶层端口 + 附录 A 寄存器，§12.1）
+`timescale 1 ns / 1 ps
+module snmp_lite #(
+  parameter integer NUM_TX_VL = 128,
+  parameter integer NUM_RX_VL = 4096,
+  parameter integer MAX_VB    = 8
+)(
+  input  wire        clk,
+  input  wire        rst_sync,
+  input  wire        en,
+  // 请求字节流（UDP 载荷）
+  input  wire        in_vld,
+  input  wire        in_sop,
+  input  wire        in_eop,
+  input  wire [7:0]  in_data,
+  input  wire [15:0] in_sport,
