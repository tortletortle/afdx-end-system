+  output wire        wr_ok,             // 该写地址合法（顶层并入 wr_known）
+
+  // ---- SNMP STATS_BLOCK 只读第二端口（组合，不产生读清）----
+  input  wire [7:0]  snmp_off,
+  output wire [31:0] snmp_rdata,
+  // ---- 给 snmp_lite 的两个标量 MIB 对象 ----
+  output wire [31:0] jit_max_o,
+  output wire [31:0] drop_total_o
