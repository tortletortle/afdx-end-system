+);
+  // ---------------- 常量 ----------------
+  localparam [7:0] T_INT = 8'h02, T_OCT = 8'h04, T_NUL = 8'h05, T_OID = 8'h06,
+                   T_SEQ = 8'h30, T_CNT = 8'h41, T_GAU = 8'h42, T_TIM = 8'h43;
