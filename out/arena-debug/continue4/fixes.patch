+    E_RIDT=45, E_RIDL=46, E_RIDB=47, E_ES0=48, E_ES1=49, E_ES2=50,
+    E_EI0=51,  E_EI1=52,  E_EI2=53,  E_VBLT=54, E_VBLL1=55, E_VBLL2=56,
