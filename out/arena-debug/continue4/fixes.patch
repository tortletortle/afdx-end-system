+  input  wire [31:0] pb_ovr_cnt,
+  input  wire [31:0] pb_qovf_cnt,
+
+  // ---- 主机口（页内偏移）----
+  input  wire        host_rd,           // 本拍主机读本页
+  input  wire        host_wr,           // 本拍主机写本页
+  input  wire [7:0]  host_off,
+  input  wire [31:0] host_wdata,
