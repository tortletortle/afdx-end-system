+  endfunction
+  function [7:0] dch; input [7:0] k;   // "AFDX-ES eLinx v1"
+    begin case (k) 0:dch="A";1:dch="F";2:dch="D";3:dch="X";4:dch="-";5:dch="E";
+                   6:dch="S";7:dch=" ";8:dch="e";9:dch="L";10:dch="i";11:dch="n";
