+  ../rtl/common/sync_fifo.v ../rtl/common/crc32.v
+  ../rtl/common/bram_sdp.v ../rtl/top/init_sweep.v ../rtl/top/AFDX_top.v
+  ../rtl/tx/tx_sn_gen.v ../rtl/tx/tx_port_buf.v
+  ../rtl/tx/tx_frame_builder.v ../rtl/tx/tx_vl_scheduler.v
+  ../rtl/tx/tx_rm.v ../rtl/tx/tx_pace.v ../rtl/tx/mac_tx_if.v
+  ../rtl/rx/mac_rx_if.v ../rtl/rx/rx_block_pool.v
+  ../rtl/rx/rx_pmem_queue.v ../rtl/rx/rx_ic.v
+  ../rtl/rx/rx_vl_lookup.v ../rtl/rx/rx_flt.v
+  ../rtl/rx/rx_rm.v ../rtl/rx/rx_ip_udp_parse.v
+  ../rtl/rx/rx_port_buf.v ../rtl/mgmt/mgmt_sap_rx.v
+  tb/tb_t23_sap_min.v tb/tb_t18_random_stress.v
+}
+file delete -force work
+vlib work
