# RX PSN BRAM mapping smoke (§7.10). Not a top-level area or timing result.
# 2026-09-23: unified RAM port maps 8192x8 PSN to 16 altsyncram (M4K).
# The earlier 3-write-site version silently expanded to 24576 DFFE even
# with rc=0, so check the mapped-cell COUNT, not just synthesis exit code.
# From workspace root:
# "C:/Program Files (x86)/eHiWay/eLinx3.0/bin/shell/bin/eLinx_synthesis.exe" \
#     -s elinx/prj/rx_ic_smoke.ys -l elinx/prj/rx_ic_smoke.log
# As for bram_sdp_smoke.ys, avoid the broken bare synth memory_switch pass.
read_verilog rtl/rx/rx_ic.v
hierarchy -top rx_ic
proc
opt
memory_dff
opt_clean
memory_collect
select -assert-count 1 t:$mem
memory_bram -rules "C:/Program Files (x86)/eHiWay/eLinx3.0/bin/shell/share/stratix/common/brams.txt"
techmap -map "C:/Program Files (x86)/eHiWay/eLinx3.0/bin/shell/share/stratix/common/brams_map.v"
opt
stat
select -assert-count 16 t:altsyncram
