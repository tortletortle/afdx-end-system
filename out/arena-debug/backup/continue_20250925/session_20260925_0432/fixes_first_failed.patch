+# --- run each test in its own vsim session ---
+$rows = New-Object System.Collections.Generic.List[string]
+$rows.Add('test_id,config,tb,result,max_dev,wall_s,summary')
+$npass = 0
+$idx = 0
+foreach ($m in $manifest) {
+  $idx++
+  $log = '../out/arena-debug/continue/session_20260925_0432/coverage/' + $m.Id + '_console.txt'
+  $env:TEST_TB = $m.Tb
+  $env:COV_DB = '../out/arena-debug/continue/session_20260925_0432/coverage/' + $m.Id + '.ucdb'
+  $sw = [Diagnostics.Stopwatch]::StartNew()
